# PostgreSQL. For `docker compose up`, the compose file sets DATABASE_URL automatically.
# For running Next.js directly on Windows with the compose DB, use localhost instead of db.
DATABASE_URL=postgresql://dao:dao@localhost:5432/dao

# Public URL of this application.
APP_BASE_URL=http://localhost:3000

# Telegram OIDC credentials from BotFather -> Login Widget.
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
# Optional; defaults to APP_BASE_URL + /api/auth/telegram/callback
TELEGRAM_OIDC_REDIRECT_URI=

# New identities start as candidates until the governance rules say otherwise.
DEFAULT_MEMBERSHIP_STATUS=candidate

# Session lifetime in days.
SESSION_TTL_DAYS=30

# Local-only testing shortcut. It is forcibly disabled when NODE_ENV=production.
DEV_AUTH_BYPASS=true
